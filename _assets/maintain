#!/bin/bash

# purpose of this script: execute maintenance tasks around fylr:
#
# - save consistent copy of sql ("dump")
# - cleanup superfluous docker files
# - update fylr and postgres (but no major version jump)
#
# The images of fylr are pulled by the digests of their release record, see
# VERIFIED UPDATES below.

# requires: docker, docker compose plugin, curl

usage(){
cat<<EOF
Maintain fylr installation in $BASEDIR, with docker compose.

/srv/fylr/maintain fylr-recreate # remove flyr container and recreate it, to reload conf
/srv/fylr/maintain recreate-fylr # dito
/srv/fylr/maintain fylr-reload   # dito
/srv/fylr/maintain fylr-reload-config # dito
/srv/fylr/maintain fylr-restart  # dito
/srv/fylr/maintain restart-fylr  # dito
/srv/fylr/maintain witness       # dito, plus follow logs (Ctrl+C to stop following)

/srv/fylr/maintain update-fylr   # pull fylr container image. Then does fylr-recreate
/srv/fylr/maintain fylr-update   # dito

/srv/fylr/maintain update        # check for updates, (re)create containers as needed
/srv/fylr/maintain start         # dito

/srv/fylr/maintain pull          # only pull the container images
                                 # All of these get the images of fylr by the digests
                                 # of their release record, see
                                 # $MAINTAIN_URL
                                 # Do not use "docker compose pull" instead.

/srv/fylr/maintain stop          # stops fylr via docker compose
                                 # DANGER: stop will be in effect even after reboot.
                                 # Do not forget to start again.

/srv/fylr/maintain restart       # stop and start

/srv/fylr/maintain backup        # dumps sql into ${BASEDIR}/sqlbackups
                                 # is also part of update
                                 # DANGER: deletes old backups until $KEEPDBS are left

/srv/fylr/maintain cleanup       # remove old files, e.g. container images
EOF
}

### DEFAULTS

# Data directory with the subdirectories "conf" etc.:
BASEDIR=/srv/fylr
BACKUPDIR="$BASEDIR"/sqlbackups
# Space-separated list of names of dbs in postgresql in container to dump:
DBS="fylr"
# Of eas DB in $DBS keep this many newest dumps:
KEEPDBS=7
# Where to write log messages to while doing update:
MYLOG=/var/log/fylr-maintain.log
# Version of this script's update procedure. A release can require a newer one.
MAINTAIN_VERSION=1
# Where the current script is:
MAINTAIN_URL=https://docs.fylr.io/for-system-administrators/installation/linux-docker-compose
# The release records: one file per tag, with the digests of the tag's images.
RELEASES_URL=https://raw.githubusercontent.com/programmfabrik/fylr-gitbook/main/_assets/releases
# Space-separated list of tags of fylr images to pull without a release record,
# e.g. "main" on a test system:
UNVERIFIED_TAGS=""

## read LOCAL CONFIG:
[ -e /etc/default/fylr ] && . /etc/default/fylr

# The release each fylr image was last updated to, to refuse an older one:
STATE="$BASEDIR"/.maintain-state
# The images an update replaced, removed once no container uses them:
OLD_IMAGES="$BASEDIR"/.maintain-old-images
# Written when a release requires a newer script, shown on every call:
DEPRECATED="$BASEDIR"/.maintain-deprecated

log(){
    echo "`date +%Y-%m-%d_%Hh%Mm%Ss` $@" >>"$MYLOG"
}

log_container_versions(){
    log "$@"
    docker ps     >>"$MYLOG"
    docker images --format table >>"$MYLOG"
}

error(){ # send output to stderr and logfile in one call
    echo "ERROR: $@" >&2
    log  "ERROR: $@"
}

errorexit(){ # exit with non-zero status AND send output to stderr and logfile in one call
    error "$@, ABORTED"
    exit 1
}

cleanup_docker(){
    #  free disk space
    #
    #  In our experience, used containers are not damaged by these commands
    #  and used images are not damaged even if they have no running container.
    #  Some error messages may be generated, however ("could not remove").

    log "removing left over temporary files..."
    LIST=$(docker ps -qa --no-trunc --filter "status=exited")
    if [ "$LIST" ] ; then
        docker rm -v $LIST >>"$MYLOG"
        log "... done."
    else
        log "... none found."
    fi

    log "removing unused images..."
    LIST=$(docker images --filter "dangling=true" -q --no-trunc)
    if [ "$LIST" ] ; then
        docker rmi $LIST >>"$MYLOG"
        log "... done."
    else
        log "... none found."
    fi

    log "removing dangling volumes..."
    LIST=$(docker volume ls -qf dangling=true)
    if [ "$LIST" ] ; then
        docker volume rm $LIST >>"$MYLOG"
        log "... done."
    else
        log "... none found."
    fi
    log All done cleaning up.
}

requires(){
    type -a "$1" &>/dev/null || errorexit "required program not installed or not in PATH: $1"
}

requires docker

### VERIFIED UPDATES
#
# The images of fylr are not pulled by what their tag points to in the
# registry. Each tag has a release record, published in another place than the
# images, that names the digest of each of its images. The image with that
# digest is pulled, docker checks the download against it, and it gets the tag
# of the compose file here on the host.

notice(){ # send output to stderr and logfile in one call
    echo "$@" >&2
    log "$@"
}

refuse(){ # say why an image is not updated; the running fylr stays as it is
    error "$1"
    [ "$2" ] && notice "$2"
    notice "fylr was NOT updated and keeps running its current version."
    rm -f "$RECORD"
    return 1
}

record_field(){ # print the value(s) of field $1 of the release record
    sed -n "s/^$1 //p" "$RECORD"
}

pull_verified(){ # pull image $1 as the release record of its tag names it
    local ref="$1" repo="${1%:*}" tag="${1##*:}"
    local url="$RELEASES_URL/$tag" required current serial last old digest
    RECORD=""
    type -a curl &>/dev/null || { refuse "curl is not installed, it gets the release record of $ref"; return 1; }
    RECORD=$(mktemp) || return 1

    curl -fsS --max-time 60 -o "$RECORD" "$url" 2>>"$MYLOG"
    case $? in
    0)  ;;
    22) # the server answered, but not with the record
        refuse "there is no release record for the tag '$tag' of $repo ($url)" \
               "Use a tag that has one, such as latest, or name '$tag' in UNVERIFIED_TAGS in /etc/default/fylr to pull it by its tag, e.g. on a test system."
        return 1 ;;
    *)  refuse "cannot get the release record $url, see $MYLOG" \
               "This host must reach raw.githubusercontent.com; a proxy can be set in /etc/default/fylr (export https_proxy=...)."
        return 1 ;;
    esac
    if [ "$(head -1 "$RECORD")" != "fylr-release 1" ] || [ "$(record_field tag)" != "$tag" ]; then
        refuse "this script (version $MAINTAIN_VERSION) cannot read the release record $url" \
               "It is probably too old for current releases. The current script: $MAINTAIN_URL"
        return 1
    fi

    required=$(record_field maintain-required)
    current=$(record_field maintain-current)
    if [ "${required:-0}" -gt "$MAINTAIN_VERSION" ]; then
        cat > "$DEPRECATED" <<EOT
This maintain script (version $MAINTAIN_VERSION) is DEPRECATED and can no longer update fylr:
fylr $(record_field version) needs version $required of it. Until you replace it, fylr
gets no updates, security updates included. The current script: $MAINTAIN_URL
EOT
        refuse "$(cat "$DEPRECATED")"
        return 1
    fi
    rm -f "$DEPRECATED"
    [ "${current:-0}" -gt "$MAINTAIN_VERSION" ] \
        && notice "NOTICE: a newer maintain script (version $current) is available, this is version $MAINTAIN_VERSION: $MAINTAIN_URL"

    serial=$(record_field serial)
    read -r last old <<<"$(sed -n "s|^$ref ||p" "$STATE" 2>/dev/null)"
    if [ "${serial:-0}" -lt "${last:-0}" ] && [ -z "$MAINTAIN_ALLOW_DOWNGRADE" ]; then
        refuse "the release record $url is older than the release installed here" \
               "To go back to fylr $(record_field version) on purpose: MAINTAIN_ALLOW_DOWNGRADE=1 $0 update"
        return 1
    fi

    # only an image of this repository in fylr's registry, by its digest
    digest=$(record_field image | grep -E "^$repo@sha256:[0-9a-f]{64}$")
    [ "$digest" ] || { refuse "the release record $url names no image for $repo"; return 1; }
    if ! { docker pull -q "$digest" &>>"$MYLOG" && docker tag "$digest" "$ref"; }; then
        refuse "cannot pull $digest, see $MYLOG" \
               "The registry cannot be reached, or it does not have the image the release record names."
        return 1
    fi

    [ "$old" ] && [ "$old" != "$digest" ] && echo "$old" >> "$OLD_IMAGES"
    { grep -v "^$ref " "$STATE" 2>/dev/null; echo "$ref $serial $digest"; } > "$STATE.new" && mv "$STATE.new" "$STATE"
    log "verified: $ref is fylr $(record_field version), $digest"
    rm -f "$RECORD"
}

pull_images(){ # pull the images of the compose file, or of its services $@
    local image failed=0
    for image in $(docker compose config --images "$@" | sort -u); do
        case "$image" in
        docker.fylr.io/fylr/fylr|docker.fylr.io/fylr/fylr-server)
            image="$image:latest" ;;
        esac
        case "$image" in
        *@sha256:*) # pinned in the compose file: docker checks the digest
            ;;
        docker.fylr.io/fylr/fylr:*|docker.fylr.io/fylr/fylr-server:*)
            if [[ " $UNVERIFIED_TAGS " != *" ${image##*:} "* ]]; then
                pull_verified "$image" || failed=1
                continue
            fi
            log "UNVERIFIED_TAGS: pulling $image without a release record" ;;
        esac
        docker pull -q "$image" &>>"$MYLOG" || { error "pull of $image failed, see $MYLOG"; failed=1; }
    done
    return $failed
}

remove_old_images(){ # the fylr images an update replaced, once no container uses them
    local image keep=""
    [ -s "$OLD_IMAGES" ] || return 0
    for image in $(sort -u "$OLD_IMAGES"); do
        grep -q " $image\$" "$STATE" 2>/dev/null && continue
        if ! docker rmi "$image" &>>"$MYLOG" && docker image inspect "$image" &>/dev/null; then
            keep="$keep$image
"
        fi
    done
    printf '%s' "$keep" > "$OLD_IMAGES"
}

sql_create_collation_func="
CREATE OR REPLACE FUNCTION check_db_collation(text) RETURNS text LANGUAGE plpgsql AS \$body\$
BEGIN
    IF (SELECT datcollversion = pg_database_collation_actual_version(oid)
        FROM pg_database WHERE datname = quote_ident(\$1)) THEN
        RETURN 'current';
	ELSE
		RETURN 'outdated';
    END IF;
END
\$body\$"

try_fix_db_collation() {
    DB=$1
    primary_database=$2

    state=`docker exec postgresql psql -U fylr -q --tuples-only -c "SELECT check_db_collation('$DB')" "$primary_database" | sed -e 's/^[[:space:]]//g'`

    case $state in
    current)
        echo "collation of database $DB is current, no need to do anything"
        return
        ;;
    outdated)
        if ! docker exec postgresql psql -U fylr -c "REINDEX DATABASE \"$DB\"" "$DB"; then
            echo "some error occurred when trying to reindex database '$DB', did not update collation version" >&2
            return
        fi
        docker exec postgresql psql -U fylr -c "ALTER DATABASE \"$DB\" REFRESH COLLATION VERSION" "$primary_database"
        ;;
    *)
        echo "got some unexpected state when checking database '$DB': $state" >&2
        ;;
    esac
}

### PARSE ARGUMENTS

log "___called with $@"

# A release needed a newer script than this one. The commands that pull say so
# themselves.
case "$1" in
pull|update-fylr|fylr-update|start|update) ;;
*) [ -e "$DEPRECATED" ] && cat "$DEPRECATED" >&2 ;;
esac

# "--pull never" below: compose does not pull an image by its tag on its own.

case "$1" in
pull)
    cd "$BASEDIR"
    pull_images
    exit $?
    ;;
update-fylr|fylr-update)
    cd "$BASEDIR"
    pull_images fylr
    failed=$?
    docker compose up --force-recreate --no-deps -d --pull never fylr || failed=1
    remove_old_images
    exit $failed
    ;;
recreate-fylr|fylr-recreate|fylr-reload|fylr-reload-config|fylr-restart|restart-fylr)
    cd "$BASEDIR"
    docker compose up --force-recreate --no-deps -d --pull never fylr
    ;;
witness)
    cd "$BASEDIR"
    docker compose up --force-recreate --no-deps -d --pull never fylr
    docker compose logs --tail all -f fylr
    ;;
start|update)
    set -e
    cd "$BASEDIR"
    failed=0
    log_container_versions "before up"
    pull_images                                  || failed=1
    docker compose up -d --no-color --pull never &>>"$MYLOG" || { error "update failed, see $MYLOG"; failed=1; }
    remove_old_images
    log_container_versions "after up"
    exit $failed
    ;;
stop)
    set -e
    cd "$BASEDIR"
    docker compose down
;;
restart)
    $0 stop 2>&1 | sed '/Network .* not found/d'
    $0 start
;;
backup)
    # do sql backup of all sql dbs $DBS
    log "starting sql dumps"
    # WARNING: there are only $KEEPDBS kept - repeating this quickly removes all old backups (on this host) !
    docker ps|grep -q 'postgresql$' || errorexit "no container named postgresql running, cannot backup"
    for DB in $DBS; do
            $0 sqldump $DB          || errorexit "sqldump db '$DB' failed"
    done
    log "finished sql dumps"
    exit 0
    ;;
fixdb)
    log "check if databases need fixes"
    docker ps|grep -q 'postgresql$' || errorexit "no container named postgresql running, cannot check"
    primary_database=`echo $DBS | awk '{print $1}'`
    docker exec postgresql psql -U fylr -c "$sql_create_collation_func" "$primary_database" >>"$MYLOG"
    for DB in "postgres" "template1" $DBS; do
        try_fix_db_collation "$DB" "$primary_database" >>"$MYLOG"
    done
    exit 0
    ;;
sqldump)
    # do sql backup of one given sql db name (inside docker container "postgresql")
    cd "$BACKUPDIR"                 || errorexit "could not change into directory '$BACKUPDIR'"
    DB="$2"
    TIME=`date +%Y-%m-%d_%Hh%Mm%Ss`
    FILE=$DB."$TIME".pgdump
    docker exec postgresql pg_dump -U fylr -v -Fc -f /mnt/${FILE}.unfinished $DB > $FILE.log 2>&1
    EXCODE=$?
    if [ $EXCODE -gt 0 ] ; then
        # FAIL. cleanup and notify
        rm ${FILE}.unfinished &>/dev/null
        mv $FILE.log  $FILE.log.FAIL &>/dev/null
        errorexit "pg_dump $DB exited with $EXCODE. Logfile is $BASEDIR/sqlbackups/$FILE.log.FAIL"
    else
        # SUCCEEDED.
        mv ${FILE}.unfinished $FILE
        # rotate so that only the last $KEEPDBS valid dumps remain. Also for logs.
        ls -1 --color=no $DB.*s.pgdump    |sort -r|tail -n +$((KEEPDBS+1))|while read i; do rm $i; done
        ls -1 --color=no $DB.*s.pgdump.log|sort -r|tail -n +$((KEEPDBS+1))|while read i; do rm $i; done
    fi
    exit 0
    ;;
cleanup)
    cleanup_docker 2>&1|grep -v 'image is being used'
    ;;
help|h|-h|--help|-help)
    usage
    ;;
*)
    echo "ERROR: argument '$1' not implemented. Try help"
    echo
    usage
    exit 2
    ;;
esac

